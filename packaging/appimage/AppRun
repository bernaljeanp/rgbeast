#!/bin/sh
# Punto de entrada del AppImage de RGBEAST.
HERE="$(dirname "$(readlink -f "$0")")"
PY="$HERE/usr/python/bin/python3"
# Archivos del servicio (helper/ y rgbeast/) para el botón "Instalar servicio".
export RGBEAST_BUNDLE="$HERE/usr/share/rgbeast"
# El agente de perfiles por juego no necesita Qt: arranca ligero.
if [ "${1:-}" = "--agente" ]; then
    shift
    exec "$PY" -I -m rgbeast.agent "$@"
fi
exec "$PY" -I -m rgbeast.app "$@"
