# Maintainer: bernaljeanp <316348178+bernaljeanp@users.noreply.github.com>
pkgname=rgbeast
pkgver=0.2.0
pkgrel=1
pkgdesc="Control center for gaming laptops: temperatures, fans, performance modes, battery, lighting and game profiles"
arch=('any')
url="https://github.com/bernaljeanp/rgbeast"
license=('GPL-3.0-only')
depends=('python' 'pyside6' 'qt6-declarative' 'qt6-svg' 'python-gobject' 'systemd' 'hicolor-icon-theme')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'qt6-shadertools')
optdepends=('power-profiles-daemon: performance modes (or tuned-ppd)'
            'nvidia-utils: NVIDIA GPU readings')
# La app se llamaba Rigcore: este paquete lo sustituye.
replaces=('rigcore')
conflicts=('rigcore')
install=rgbeast.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/bernaljeanp/rgbeast/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('32828c3093f3247a7f8148fbf33adc8d8b12dcdf19d1b81564f0a9b814c431f3')

build() {
  cd "$pkgname-$pkgver"
  # Shaders built with the distro Qt (a newer .qsb may not load on an older Qt).
  QSB=/usr/lib/qt6/bin/qsb sh tools/build_shaders.sh
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  sh packaging/install-files.sh "$pkgdir" /usr/lib/rgbeast
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
